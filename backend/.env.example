# Copy to .env, fill in your own values, then load it before running:
#   set -a; source .env; set +a
# All values below are placeholders. Never commit a real .env file.

# Development database (PostgreSQL)
db_url_dev=jdbc:postgresql://localhost:5432/techshirt
db_username_dev=postgres
db_password_dev=change-me

# Production database (only needed with SPRING_PROFILES_ACTIVE=prod)
db_url_prod=jdbc:postgresql://localhost:5432/techshirt
db_username_prod=postgres
db_password_prod=change-me

# Secret used to sign JWTs. Use a long random string.
security_token_secret=change-me-to-a-long-random-string

# Swagger server URLs
swagger_dev_url=http://localhost:8080
swagger_prod_url=http://localhost:8080

# Allowed CORS origins, comma separated
cors_allowed_origins=http://localhost:5173

# SMTP account used for transactional emails (Gmail app password, for example)
mail_username=you@example.com
mail_password=change-me

# Firebase Storage bucket used for QR code images
firebase_storage_bucket=your-project-id.firebasestorage.app
